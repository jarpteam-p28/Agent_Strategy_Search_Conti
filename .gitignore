.pytest_cache/

# Downloaded paper PDFs are cached locally / in CI only - never committed (copyrighted).
papers/pdfs/*.pdf

# Raw third-party material (YouTube transcripts, screenshots, paper PDFs you drop in the inbox).
# This repo is PUBLIC, so these stay out of git. If you make the repo private, delete these
# three lines so the weekly agents in GitHub Actions can see new transcripts and inbox PDFs.
transcripts/*.txt
transcripts/screenshots/
papers/inbox/*.pdf

# Market data lives on the local drive (NinjaTrader export), not in git.
data/
